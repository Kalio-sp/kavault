# ===================================================================
# KAVAULT — Environment Variables Example
# Скопируйте этот файл в .env и укажите ваши приватные ключи и пароли
# ВНИМАНИЕ: Файл .env добавлен в .gitignore и НИКОГДА не коммитится в Git!
# ===================================================================

# 1. PostgreSQL Database
POSTGRES_USER=kavault_user
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=kavault_db

# 2. JWT Security (минимум 32 случайных символа)
JWT_SECRET=generate_a_random_cryptographic_secret_here

# 3. Аккаунт Создателя (Администратора)
CREATOR_EMAIL=zerkalovandrey@kavoult.dev
CREATOR_INITIAL_PASSWORD=set_initial_admin_password_here
CREATOR_NICKNAME=zerkalovandrey

# 4. Порты
PORT=4000
