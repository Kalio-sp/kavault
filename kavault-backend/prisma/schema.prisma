generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS (Перечисления)
// =======================

enum ResourceType {
  ARTICLE
  DOCUMENTATION
  WEBSITE
  REPOSITORY
  VIDEO
}

enum LearningStatus {
  TO_LEARN
  LEARNING
  COMPLETED
}

enum CardType {
  VOCABULARY
  KANJI
  GRAMMAR
  KANA
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// =======================
// MODELS (Таблицы)
// =======================

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  nickname             String?        @unique
  password             String
  studyLanguage        String         @default("ja")
  showProgramming      Boolean        @default(true)
  onboardingCompleted  Boolean        @default(true)
  mmr                  Int            @default(0)
  mmrInitialized       Boolean        @default(false)
  thoughtPreferences   Json?
  unlockedAchievements Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Связи с другими таблицами
  resources            Resource[]
  japaneseCards        JapaneseCard[]
  studyPassages        StudyPassage[]
  sentFriendships      Friendship[]   @relation("SentFriendships")
  receivedFriendships  Friendship[]   @relation("ReceivedFriendships")
  mmrLogs              MmrLog[]
  sharedDecks          SharedDeck[]
  thoughts             ThoughtNote[]
}

model Resource {
  id          String         @id @default(uuid())
  title       String         // Название материала
  url         String         // Ссылка
  description String?        // Краткое описание
  type        ResourceType   @default(ARTICLE)
  status      LearningStatus @default(TO_LEARN)
  tags        String[]       // Массив тегов
  note        String?        @db.Text // Личные заметки
  mmrAwarded  Boolean        @default(false)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model JapaneseCard {
  id          String   @id @default(uuid())

  word        String   // Слово, кандзи или грамматика
  reading     String?  // Чтение (хирагана/катакана)
  meaning     String   // Перевод
  example     String?  // Пример использования

  type        CardType @default(VOCABULARY)
  language    String   @default("ja")
  studyLevel  String?

  // Система интервального повторения (SRS)
  level       Int      @default(0) // 0 - новое, 1+ - в процессе повторения
  nextReview  DateTime @default(now()) // Когда повторить в следующий раз

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model StudyPassage {
  id          String   @id @default(uuid())
  language    String   @default("ja")
  kind        String   @default("READING")
  level       String   @default("A1")
  title       String
  content     String   @db.Text
  translation String   @db.Text
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ReceivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model MmrLog {
  id        String   @id @default(uuid())
  userId    String
  actionKey String?
  reason    String
  delta     Int
  meta      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, actionKey])
}

model SharedDeck {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  language    String   @default("ja")
  levelFilter String   @default("ALL")
  cards       Json
  passages    Json?
  importCount Int      @default(0)
  authorId    String
  createdAt   DateTime @default(now())

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

model ThoughtNote {
  id         String   @id @default(uuid())
  title      String?
  content    String   @db.Text
  mood       String?
  colorTag   String   @default("default")
  tags       String[]
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived, isPinned, updatedAt])
}
